# ============================================================
# 前端配置（复制为 .env 后按需修改，Vite 需以 VITE_ 前缀）
# ============================================================

# 后端 API 基础地址
VITE_API_BASE=http://127.0.0.1:8000

# —— 形式一：Cesium 全卫星视图 ——
# 每单位时间倍率 M 对应的时间窗（秒）。实际时间窗 = 该值 × M。
VITE_CESIUM_WINDOW=1800
# 每单位 M 的基准采样数。实际采样数 ≈ 该值 / M（M 越大采样率越低）。
VITE_CESIUM_SAMPLES=60
# 默认时间倍率 M（1 = 实时）
VITE_DEFAULT_M=1

# —— 形式二：单星座聚类散点图 ——
# 倾角聚类间隔（度）：间隔超过该值的卫星分到不同倾角壳层
VITE_INCL_GAP=3
# 轨道高度聚类间隔（km）：同一倾角壳层内再按该间隔分高度层
VITE_ALT_GAP=300
