# ============================================================
# 后端配置（复制为 .env 后按需修改）
# ============================================================

# 服务监听地址与端口
HOST=0.0.0.0
PORT=8000

# TLE 刷新周期（秒）。celestrak 每 2 小时更新一次数据，默认 7200。
# 仅在超过该周期后才会重新拉取，避免触发 celestrak 的限流策略。
TLE_REFRESH_PERIOD=7200

# 需要抓取的星座 / 卫星群（celestrak GROUP 名，逗号分隔）。
# 默认覆盖主流通讯与导航星座。starlink 体量最大（6000+），可按需取舍。
SAT_GROUPS=starlink,oneweb,iridium-NEXT,globalstar,orbcomm,gps-ops,galileo,beidou,glonass,ses,intelsat

# celestrak GP 数据接口基础地址
CELESTRAK_BASE=https://celestrak.org/NORAD/elements/gp.php

# SQLite 数据库文件路径（相对/绝对均可）
DATABASE_PATH=../data/satellites.db

# 允许的前端跨域来源（逗号分隔），开发时一般为 vite 默认地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
